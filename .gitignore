# VS Code: ignore local settings, keep shared extension recommendations
.vscode/*
!.vscode/extensions.json

# PowerShell / Pester output
TestResults/
*.log

# Bicep build output and generated ARM templates
infra/**/bin/
build/

# Local-only files (never commit)
.env
*.local.bicepparam
*.secret.*

# OS junk
.DS_Store
Thumbs.db
